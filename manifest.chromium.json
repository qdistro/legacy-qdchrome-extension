{
  "manifest_version": 3,
  "name": "qdistro browser bridge",
  "version": "0.2.0",
  "description": "qdistro native-messaging client: tabs, pwd, page-extract, cookies, mpris, downloads, notifications, screen-lock.",
  "minimum_chrome_version": "126",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "activeTab",
    "cookies",
    "downloads",
    "notifications",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "qdistro browser bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}

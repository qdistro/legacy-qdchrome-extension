{
  "manifest_version": 2,
  "name": "qdistro browser bridge",
  "version": "0.2.0",
  "description": "qdistro native-messaging client: tabs, pwd, page-extract, cookies, mpris, downloads, notifications, screen-lock.",
  "browser_specific_settings": {
    "gecko": {
      "id": "qdistro@qdistro.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "activeTab",
    "cookies",
    "downloads",
    "notifications",
    "contextMenus",
    "storage",
    "<all_urls>"
  ],
  "browser_action": {
    "default_title": "qdistro browser bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png"
  },
  "background": {
    "scripts": ["background.bundle.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/pwd-content.js",
        "src/content/mpris-content.js",
        "src/content/screenlock-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
